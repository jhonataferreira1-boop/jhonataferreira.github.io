3. Consultas SQL (SELECT)
-- ======================================================
-- CONSULTAS SELECT COMPLETAS
-- ======================================================
SELECT a.nome AS animal, a.especie, c.nome AS tutor
FROM animal a
JOIN cliente c ON a.id_cliente = c.id_cliente
ORDER BY tutor;
SELECT ag.id_agendamento, ag.data_agendamento, ag.hora_agendamento,
v.nome AS veterinario, s.descricao AS servico
FROM agendamento ag
JOIN veterinario v ON ag.id_veterinario = v.id_veterinario
JOIN servico s ON ag.id_servico = s.id_servico
WHERE ag.data_agendamento >= CURDATE()
ORDER BY ag.data_agendamento;
SELECT at.id_atendimento, at.data_atendimento,
an.nome AS animal, v.nome AS veterinario,
s.descricao AS servico
FROM atendimento at
JOIN animal an ON at.id_animal = an.id_animal
JOIN veterinario v ON at.id_veterinario = v.id_veterinario
JOIN servico s ON at.id_servico = s.id_servico
ORDER BY at.data_atendimento DESC;
SELECT * FROM servico
WHERE preco > 100
ORDER BY preco DESC;
SELECT e.id_exame, e.tipo_exame, e.data_realizacao,
a.id_atendimento, an.nome AS animal
FROM exame e
JOIN atendimento a ON e.id_atendimento = a.id_atendimento
JOIN animal an ON a.id_animal = an.id_animal;
