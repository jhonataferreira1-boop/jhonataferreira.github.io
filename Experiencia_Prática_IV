Experiência Prática IV – Implementação Completa
1. Script DDL (Criação do Banco e Tabelas)
-- ======================================================
-- BANCO DE DADOS DOCTOR PET (DDL COMPLETO)
-- ======================================================
CREATE DATABASE IF NOT EXISTS doctorpet;
USE doctorpet;
CREATE TABLE cliente (
id_cliente INT AUTO_INCREMENT PRIMARY KEY,
nome VARCHAR(100) NOT NULL,
cpf VARCHAR(14) NOT NULL,
telefone VARCHAR(15) NOT NULL,
email VARCHAR(100) NOT NULL,
endereco VARCHAR(255) NOT NULL
);
CREATE TABLE veterinario (
id_veterinario INT AUTO_INCREMENT PRIMARY KEY,
nome VARCHAR(100) NOT NULL,
crm VARCHAR(20) NOT NULL,
especialidade VARCHAR(50) NOT NULL,
telefone VARCHAR(15) NOT NULL,
email VARCHAR(100) NOT NULL
);
CREATE TABLE servico (
id_servico INT AUTO_INCREMENT PRIMARY KEY,
descricao VARCHAR(100) NOT NULL,
preco FLOAT NOT NULL,
tipo_servico VARCHAR(50) NOT NULL
);
CREATE TABLE animal (
id_animal INT AUTO_INCREMENT PRIMARY KEY,
nome VARCHAR(100) NOT NULL,
especie VARCHAR(50) NOT NULL,
raca VARCHAR(50) NOT NULL,
data_nascimento DATE NOT NULL,
sexo VARCHAR(10) NOT NULL,
peso FLOAT,
id_cliente INT NOT NULL,
CONSTRAINT fk_animal_cliente
FOREIGN KEY (id_cliente) REFERENCES cliente(id_cliente)
ON UPDATE CASCADE ON DELETE CASCADE
);
CREATE TABLE agendamento (
id_agendamento INT AUTO_INCREMENT PRIMARY KEY,
id_cliente INT NOT NULL,
id_veterinario INT NOT NULL,
data_agendamento DATE NOT NULL,
hora_agendamento TIME NOT NULL,
id_servico INT NOT NULL,
CONSTRAINT fk_agendamento_cliente
FOREIGN KEY (id_cliente) REFERENCES cliente(id_cliente)
ON UPDATE CASCADE ON DELETE CASCADE,
CONSTRAINT fk_agendamento_vet
FOREIGN KEY (id_veterinario) REFERENCES veterinario(id_veterinario)
ON UPDATE CASCADE ON DELETE CASCADE,
CONSTRAINT fk_agendamento_servico
FOREIGN KEY (id_servico) REFERENCES servico(id_servico)
ON UPDATE CASCADE ON DELETE CASCADE
);
CREATE TABLE atendimento (
id_atendimento INT AUTO_INCREMENT PRIMARY KEY,
data_atendimento DATETIME NOT NULL,
id_animal INT NOT NULL,
id_veterinario INT NOT NULL,
id_servico INT NOT NULL,
diagnostico TEXT,
prescricao TEXT,
CONSTRAINT fk_atendimento_animal
FOREIGN KEY (id_animal) REFERENCES animal(id_animal)
ON UPDATE CASCADE ON DELETE CASCADE,
CONSTRAINT fk_atendimento_veterinario
FOREIGN KEY (id_veterinario) REFERENCES veterinario(id_veterinario)
ON UPDATE CASCADE ON DELETE CASCADE,
CONSTRAINT fk_atendimento_servico
FOREIGN KEY (id_servico) REFERENCES servico(id_servico)
ON UPDATE CASCADE ON DELETE CASCADE
);
CREATE TABLE exame (
id_exame INT AUTO_INCREMENT PRIMARY KEY,
id_atendimento INT NOT NULL,
tipo_exame VARCHAR(100) NOT NULL,
resultado TEXT,
data_realizacao DATE NOT NULL,
CONSTRAINT fk_exame_atendimento
FOREIGN KEY (id_atendimento) REFERENCES atendimento(id_atendimento)
ON UPDATE CASCADE ON DELETE CASCADE
);
